[Unit]
Description=Remote Control do Claude Code no zippi-datawarehouse
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=forking
User=sv
ExecStart=/usr/bin/tmux -L zippi new-session -d -s zippi "zsh -lic zippi-rc"
ExecStop=/usr/bin/tmux -L zippi kill-server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
