#!/bin/sh
# Envia o dataset de turnos avaliados (mod rating) para o repo privado joaosavi/agent-ratings.
# Roda uma vez por dia pelo avaliacoes-backup.timer.
#
# Antes do commit, cada arquivo mudado passa pelo filtro do segredo.pl, que troca valor de segredo
# por <oculto:NOME>. O secret-guard esconde o segredo na saída das ferramentas, mas o pedido e a
# resposta do agente podem trazer um valor colado, e nada disso pode chegar ao GitHub.
# O filtro roda sob o mesmo flock que o mod usa para acrescentar linhas, para não perder linha.
set -eu
D="${AVALIACOES_DIR:-$HOME/datasets/agent-ratings}"
FILTRO="$HOME/claude-devcontainer/hooks/segredo.pl"
cd "$D" || exit 0
[ -f "$FILTRO" ] || { echo "falta o $FILTRO, nada foi enviado" >&2; exit 1; }

git status --porcelain --untracked-files=all | awk '{print $NF}' | grep '\.jsonl$' | while read -r f; do
  flock "$f.lock" sh -c 'perl "$2" filtro < "$1" > "$1.limpo" && mv "$1.limpo" "$1"' sh "$f" "$FILTRO"
done

git add -A
git diff --cached --quiet && exit 0
git commit -q -m "Dataset até $(date -u +%F)"
for espera in 0 2 4 8 16; do
  sleep "$espera"
  git push -q origin main && exit 0
done
echo "push falhou depois de 5 tentativas" >&2
exit 1
