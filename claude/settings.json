{
  "env": {
    "GITHUB_TOKEN": "",
    "BI_MCP_PG_URL": "",
    "CLAUDE_CODE_ARTIFACT": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(bw:*)"
    ]
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "anthropic-skills:conciliacao-inter-erp": "off",
    "anthropic-skills:diagnostico-leads": "off",
    "anthropic-skills:mentor-sdr": "off",
    "anthropic-skills:post-linkedin-getdemo": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:radar-linkedin": "off",
    "abnt-esag": "name-only",
    "archify": "name-only",
    "codebase-design": "name-only",
    "find-skills": "name-only",
    "git-guardrails-claude-code": "name-only",
    "how": "name-only",
    "why": "name-only",
    "principios": "name-only",
    "prototype": "name-only",
    "recall": "name-only",
    "research": "name-only",
    "setup-pre-commit": "name-only",
    "humanizer": "name-only",
    "keybindings-help": "name-only",
    "fewer-permission-prompts": "name-only",
    "loop": "name-only",
    "schedule": "name-only",
    "run": "name-only",
    "init": "name-only",
    "security-review": "name-only",
    "simplify": "name-only",
    "code-review": "name-only",
    "plugin-authoring": "name-only",
    "artifact-diagramming": "name-only",
    "artifact-capabilities": "name-only",
    "workflow-authoring": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "perl \"$HOME/.claude/hooks/segredo.pl\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "perl \"$HOME/.claude/hooks/segredo.pl\" post"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/claude-devcontainer/mods/hud/statusline/statusline.sh",
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-hud@claude-hud": false,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "mattpocock-skills@mattpocock": true,
    "cockpit@cockpit": true,
    "usage-limit@cockpit": true,
    "memory-guard@cockpit": true,
    "skill-loader@cockpit": true,
    "audit@cockpit": true,
    "loop-breaker@cockpit": true,
    "secret-guard@cockpit": true,
    "pipefail@cockpit": true,
    "mod-report@cockpit": true,
    "rating@cockpit": true,
    "wtf@cockpit": true,
    "hud@cockpit": true,
    "spinner-status@cockpit": true,
    "collision-guard@cockpit": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    },
    "cockpit": {
      "source": {
        "source": "directory",
        "path": "/home/sv/claude-devcontainer"
      },
      "autoUpdate": true
    }
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "xhigh",
  "autoCompactWindow": 733000,
  "pluginConfigs": {
    "secret-guard@cockpit": {
      "options": {
        "envRoot": "~/getdemo"
      }
    },
    "usage-limit@cockpit": {
      "options": {
        "timeZone": "America/Sao_Paulo"
      }
    },
    "audit@cockpit": {
      "options": {
        "timeZone": "America/Sao_Paulo"
      }
    },
    "hud@cockpit": {
      "options": {
        "timeZone": "America/Sao_Paulo",
        "band": "off",
        "activity": true,
        "style": "refined",
        "icons": "nerd"
      }
    },
    "pipefail@cockpit": {
      "options": {
        "extraRunners": [
          "verificar",
          "regras"
        ]
      }
    },
    "rating@cockpit": {
      "options": {
        "configRepo": "~/claude-devcontainer"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
